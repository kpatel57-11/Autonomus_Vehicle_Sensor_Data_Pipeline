# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# MongoDB (pipeline recipes)
MONGO_URI=mongodb://avadmin:avpassword@localhost:27017/av_pipeline?authSource=admin

# PostgreSQL (dataset metadata)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=av_metadata
POSTGRES_USER=avuser
POSTGRES_PASSWORD=avpassword

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Spark
SPARK_MASTER=local[*]

# Storage
HDFS_BASE=/tmp/av
DELTA_PATH=/tmp/av/delta
S3_BUCKET=av-sensor-data

# Pipeline
PIPELINE_MODE=batch
LOG_LEVEL=INFO
WATERMARK_DELAY=10 minutes
